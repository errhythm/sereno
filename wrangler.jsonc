{
  "name": "sereno",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-10",
  "routes": [
    { "pattern": "sereno.errhythm.me", "custom_domain": true }
  ],
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/callback"]
  }
}
